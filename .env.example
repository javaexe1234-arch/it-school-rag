GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
PORT=5500

# --- Источник базы знаний ---
# Google Drive: ID папки (часть адреса https://drive.google.com/drive/folders/<ID>)
# и JSON-ключ сервисного аккаунта Google Cloud. Если ID не задан — используется папка knowledge/.
#GOOGLE_DRIVE_FOLDER_ID=
#GOOGLE_SERVICE_ACCOUNT_FILE=google-service-account.json
# Как часто проверять изменения документов (секунды). Перед каждым ответом ассистента
# изменения проверяются дополнительно (не чаще раза в 5 секунд).
RAG_POLL_SECONDS=15
# Локальная папка (если Google Drive не используется)
#RAG_LOCAL_DIR=knowledge

# Вместимость группы по умолчанию (если в листе «Расписание» нет колонки «Мест»)
GROUP_CAPACITY=12
